* text=auto eol=lf

# Pustaka pihak ketiga disimpan apa adanya: baris baru CRLF milik paket
# tidak boleh dinormalisasi, supaya checksum tetap sama dengan rilis resmi.
public/vendor/** -text

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
