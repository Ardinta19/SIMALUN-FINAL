APP_NAME="Berkah Kreatif SIMALUN"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simalun
DB_USERNAME=root
DB_PASSWORD=

# Untuk dev cepat tanpa MySQL: ganti DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── Production Security (uncomment saat deploy) ─────────────────────
# SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Ganti dengan alamat email domain sendiri (mis. pesanan@berkahkreatif.id).
# Email pemulihan kata sandi dari alamat contoh akan masuk folder spam atau
# ditolak penerima karena domainnya bukan milik toko.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# ─── Identitas Usaha ─────────────────────────────────────────────────
BUSINESS_NAME="Berkah Kreatif"
BUSINESS_TAGLINE="Papan bunga untuk setiap cerita"
# Usaha belum punya outlet resmi: biarkan alamat & peta kosong.
# Lokasi serah terima disepakati lewat WhatsApp.
BUSINESS_ADDRESS=""
BUSINESS_GMAPS=""
BUSINESS_PHONE_DISPLAY="0895-1405-7305"
BUSINESS_WA="6289514057305"
BUSINESS_INSTAGRAM="https://www.instagram.com/berkahkreatif_/"
BUSINESS_TIKTOK="https://www.tiktok.com/@berkahkreatif_"

# ─── Pengingat untuk server produksi ───
# Berkas ini disetel untuk pengembangan lokal. Saat memasang di server:
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://domain-anda
#   SESSION_SECURE_COOKIE=true
#   LOG_LEVEL=warning
#   MAIL_MAILER=smtp                 (bawaan baris 58 `log` hanya menulis
#                                     surel ke storage/logs — pelanggan yang
#                                     menekan "Lupa sandi" tidak akan pernah
#                                     menerima tautannya)
#   MAIL_HOST=smtp.domain-anda  MAIL_PORT=587  MAIL_SCHEME=tls
#   MAIL_USERNAME=...  MAIL_PASSWORD=...
#   MAIL_FROM_ADDRESS="pesanan@domain-anda"
# Lalu jalankan `php artisan config:cache`. Akun admin dibuat dengan
# `php artisan user:create`; `db:seed` hanya membuat akun demo di local/testing.

# ─── Proxy Tepercaya ───
# "*" = seperti bawaan lama: percayai header X-Forwarded-* dari proxy hosting
# (dibutuhkan supaya HTTPS terdeteksi di balik proxy). Bila server punya TLS
# sendiri, ganti dengan daftar IP proxy, mis. "127.0.0.1,::1".
TRUSTED_PROXIES="*"

# ─── Google OAuth (Login with Google) ───
# Dapatkan dari Google Cloud Console → APIs & Services → Credentials.
# GOOGLE_REDIRECT_URI harus sama persis dengan Authorized redirect URI di sana.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
