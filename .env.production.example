APP_NAME="Berkah Kreatif SIMALUN"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Ganti dengan domain produksi Berkah Kreatif.
APP_URL=https://__DOMAIN_PRODUKSI__

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@__DOMAIN_PRODUKSI__"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Identitas usaha (dibaca config/laundry.php). Kunci bergaya laundry pada
# aplikasi lama sudah tidak dipakai; nilai di bawah inilah yang tampil di
# footer, email, dan ringkasan pesanan.
BUSINESS_NAME="Berkah Kreatif"
BUSINESS_TAGLINE="Papan bunga untuk setiap cerita"
# Belum punya outlet resmi: kosongkan alamat & peta. Lokasi serah terima
# disepakati lewat WhatsApp.
BUSINESS_ADDRESS=""
BUSINESS_GMAPS=""
BUSINESS_PHONE_DISPLAY="0895-1405-7305"
BUSINESS_WA="6289514057305"
BUSINESS_INSTAGRAM="https://www.instagram.com/berkahkreatif_/"
BUSINESS_TIKTOK="https://www.tiktok.com/@berkahkreatif_"

GOOGLE_CLIENT_ID=__ISI__
GOOGLE_CLIENT_SECRET=__ISI__
GOOGLE_REDIRECT_URI=https://__DOMAIN_PRODUKSI__/auth/google/callback
