<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!--
            Identitas usaha dipaku di sini supaya hasil tes tidak bergantung
            pada `.env` pengembang. Sebelumnya `.env` lama (merek "Azka
            Laundry" beserta nomor WhatsApp-nya) ikut terbaca dan membuat
            tes footer/galat gagal hanya di mesin tertentu.
        -->
        <env name="BUSINESS_NAME" value="Berkah Kreatif"/>
        <env name="BUSINESS_TAGLINE" value="Papan bunga untuk setiap cerita"/>
        <!-- Usaha belum punya outlet: alamat dan peta dikunci kosong agar tes
             tidak bergantung `.env` yang mungkin masih memuat alamat lama. -->
        <env name="BUSINESS_ADDRESS" value=""/>
        <env name="BUSINESS_GMAPS" value=""/>
        <env name="BUSINESS_PHONE_DISPLAY" value="0895-1405-7305"/>
        <env name="BUSINESS_WA" value="6289514057305"/>
        <env name="BUSINESS_INSTAGRAM" value="https://www.instagram.com/berkahkreatif_/"/>
        <env name="BUSINESS_TIKTOK" value="https://www.tiktok.com/@berkahkreatif_"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
